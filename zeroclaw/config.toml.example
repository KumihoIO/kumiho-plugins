# Kumiho Memory MCP Server for ZeroClaw
# Add this section to your ~/.zeroclaw/config.toml
#
# Prerequisites:
#   pip install "kumiho[mcp]>=0.9.16" "kumiho-memory[all]>=0.3.16"
#   export KUMIHO_AUTH_TOKEN=<your-firebase-id-token>
#
# Obtain a token via:
#   python -m kumiho.auth_cli login
# The token is stored in ~/.kumiho/kumiho_authentication.json (id_token field).
#
# After adding this config, ZeroClaw will discover all kumiho tools
# via the MCP handshake. Tools are named kumiho_memory__<full tool name>
# (server name + "__" + the tool's advertised name), e.g.
# kumiho_memory__kumiho_memory_engage.
# Use tool_search("kumiho") in-session to see available tools.

[mcp]
enabled = true
deferred_loading = false

[[mcp.servers]]
name = "kumiho_memory"
transport = "stdio"
command = "python"
args = ["-m", "kumiho.mcp_server"]
tool_timeout_secs = 30

[mcp.servers.env]
KUMIHO_AUTH_TOKEN = "${KUMIHO_AUTH_TOKEN}"
# Optional: override control plane URL (default: https://control.kumiho.cloud)
# KUMIHO_CONTROL_PLANE_URL = "${KUMIHO_CONTROL_PLANE_URL}"
