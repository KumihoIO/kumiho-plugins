# Kumiho auth token — must be a Firebase ID token or Control Plane JWT.
# Dashboard API keys (kh_live_...) are NOT accepted by the MCP server.
#
# Obtain via CLI login (writes id_token to ~/.kumiho/kumiho_authentication.json):
#   python -m kumiho.auth_cli login
#
# Or run the setup wizard which handles this automatically:
#   python scripts/setup.py
KUMIHO_AUTH_TOKEN=<firebase-id-token>

# Optional: override control plane URL
# KUMIHO_CONTROL_PLANE_URL=https://control.kumiho.cloud
