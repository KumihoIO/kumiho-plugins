{
  "description": "Kumiho memory plugin hooks — session bootstrap, auto-approval, artifact generation, and Decision Memory auto-capture",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_DATA}/venv/bin/pythonw",
            "timeout": 5,
            "statusMessage": "Bootstrapping Kumiho memory...",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/session-bootstrap.py"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_DATA}/venv/bin/pythonw",
            "timeout": 5,
            "statusMessage": "kumiho",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/code-capture-hook.py"
            ]
          }
        ]
      },
      {
        "matcher": "mcp__.*kumiho-memory.*__kumiho_memory_(engage|reflect|consolidate)",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_DATA}/venv/bin/pythonw",
            "timeout": 10,
            "async": true,
            "statusMessage": "kumiho",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/reflex-observe.py"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_DATA}/venv/bin/pythonw",
            "timeout": 10,
            "statusMessage": "Saving session artifact...",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/save-session-artifact.py"
            ]
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_DATA}/venv/bin/pythonw",
            "timeout": 5,
            "statusMessage": "Capturing code decisions...",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/code-capture-hook.py"
            ]
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "mcp__.*kumiho-memory.*__kumiho_.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_DATA}/venv/bin/pythonw",
            "timeout": 5,
            "statusMessage": "kumiho",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/auto-approve-memory.py"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_DATA}/venv/bin/pythonw",
            "timeout": 10,
            "async": true,
            "statusMessage": "kumiho",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/reflex-observe.py"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_DATA}/venv/bin/pythonw",
            "timeout": 5,
            "statusMessage": "kumiho",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/memory-reflex.py"
            ]
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_DATA}/venv/bin/pythonw",
            "timeout": 5,
            "statusMessage": "kumiho",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/memory-reflex.py",
              "--subagent"
            ]
          }
        ]
      }
    ]
  }
}
