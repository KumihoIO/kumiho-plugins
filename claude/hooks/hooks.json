{
  "description": "Kumiho memory plugin hooks — session bootstrap, auto-approval, artifact generation, and Decision Memory auto-capture",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/session-bootstrap.py\"",
            "timeout": 5,
            "statusMessage": "Bootstrapping Kumiho memory..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/code-capture-hook.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/save-session-artifact.py\"",
            "timeout": 10,
            "statusMessage": "Saving session artifact..."
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/code-capture-hook.py\"",
            "timeout": 5,
            "statusMessage": "Capturing code decisions..."
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "mcp__.*kumiho-memory.*__kumiho_.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/auto-approve-memory.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
