    "name": "Kumiho Inc.",
    "url": "https://kumiho.io"
  },
  "homepage": "https://kumiho.io",
  "repository": "https://github.com/KumihoIO/kumiho-plugins",
  "license": "MIT",
  "keywords": [
    "memory",
    "kumiho",
    "mcp",
    "hermes",
    "decisions"
  ],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "kumiho-memory": {
          "trust": "untrusted"
        }
      }
    }
  }
}
